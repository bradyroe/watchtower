{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListSecurityLogBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::example-security-logs-111122223333"
    },
    {
      "Sid": "ReadSecurityLogs",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::example-security-logs-111122223333/*"
    }
  ]
}
